# URL base de la web-builder-api (usada por los server components, que llaman
# a la API directamente por la red interna, sin pasar por Caddy).
API_URL=http://localhost:4000

# URL base para las llamadas desde el navegador (formulario de contacto).
#
# Déjalo VACÍO cuando entres por Caddy (http://localhost, puerto 80): la API se
# sirve bajo el mismo host que la web, así que las llamadas salen relativas
# (`/api/contact`), son del mismo origen y no hay CORS de por medio.
#
# Ponle `http://localhost:4000` solo si entras directo a `next dev` en el 3000,
# saltándote el proxy. En ese caso el origen es distinto y CORS_ORIGIN de la
# API tiene que incluir cada dominio de tenant que uses.
NEXT_PUBLIC_API_URL=

# Secreto compartido con la API para invalidar la caché del sitio publicado
# (SPEC 0.2). Tiene que ser EL MISMO valor que `REVALIDATE_SECRET` en
# web-builder-api/.env. Genera uno propio, por ejemplo con `openssl rand -hex 32`.
# Vacío = el endpoint /api/revalidate rechaza todo, y los cambios tardan en
# verse lo que dure la caché (1 hora).
REVALIDATE_SECRET=

# Dominio de la plataforma, el mismo valor que PLATFORM_DOMAIN en web-builder-api/.env. Las
# demos de prospecto viven en `demo-<slug>.<PLATFORM_DOMAIN>`: con esto definido, solo esos
# hosts se tratan como demo (sin caché, noindex, robots.txt cerrado). Vacío = cualquier host
# cuyo primer tramo empiece por `demo-`. El panel también la usa para la vista previa de la
# dirección al crear una demo (la definitiva la devuelve la API).
PLATFORM_DOMAIN=localhost
